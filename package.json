{
  "name": "@webship-js/laravel-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for apps made from the official starter kits, a plugin for webship-js (Playwright and Cucumber): the session and its limits, registration refusals, the password reset through the mail, email verification, password confirmation, the settings pages, notifications, field errors, the error pages, maintenance mode and the debug page check.",
  "main": "tests/step-definitions/laravel-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:maintenance": "CUCUMBER_TAGS=@maintenance cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "laravel",
    "starter-kit",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/laravel-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/laravel-steps/issues"
  },
  "homepage": "https://github.com/webship/laravel-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
